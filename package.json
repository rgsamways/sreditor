{
  "name": "sreditor",
  "version": "0.0.4",
  "description": "SR&ED-eligibility judgment CLI for developers using OpenSpec-driven agentic coding workflows.",
  "type": "module",
  "bin": {
    "sreditor": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sred",
    "cra",
    "tax-credit",
    "openspec",
    "cli",
    "claude",
    "anthropic"
  ],
  "author": {
    "name": "Robin Samways",
    "email": "rgsamways@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgsamways/sreditor.git"
  },
  "homepage": "https://github.com/rgsamways/sreditor#readme",
  "bugs": {
    "url": "https://github.com/rgsamways/sreditor/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@clack/prompts": "^1.7.0",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.14.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
